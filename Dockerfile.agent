# syntax=docker/dockerfile:1

# Dockerfile.agent — openscientist-agent image
#
# Runs a single OpenScientist job in an isolated container.
# Builds on openscientist-base (Python 3.12, uv, git) and installs the full
# openscientist package so the agent can import orchestrator/discovery code.
#
# Build (UDWA is private, so authenticate through a BuildKit secret):
#   GITHUB_TOKEN="$(gh auth token)" docker build \
#     --secret id=github_token,env=GITHUB_TOKEN \
#     -f Dockerfile.agent -t openscientist-agent:latest .
#
# Labels:
#   openscientist.job_id=<uuid>   set by JobContainerRunner at runtime
#   openscientist.type=agent

# --- Stage: build the open-codex CLI from the fork --------------------------
# The open-codex branch carries the fixes that let codex drive open-weight
# models served by Ollama: flatten MCP namespace tools for providers without
# namespace support, a function-form apply_patch (with a +-prefix patch-body
# description so open models format added lines correctly), and a web_search
# capability gate that stops the hosted tool from corrupting tool calls on
# non-OpenAI providers. Pinned to a commit on open-codex for reproducibility.
FROM rust:1.95-bookworm AS codex-build
ARG CODEX_REPO=https://github.com/LucaCappelletti94/codex.git
ARG CODEX_REF=8f8009fcab89baafa51c15c9542734b1c94de8b6
RUN set -eux; \
    git init /codex; \
    git -C /codex remote add origin "${CODEX_REPO}"; \
    attempt=1; \
    while true; do \
        if git -c http.version=HTTP/1.1 -C /codex fetch \
            --depth=1 --no-tags origin "${CODEX_REF}"; then \
            break; \
        fi; \
        if [ "${attempt}" -ge 5 ]; then \
            echo "Failed to fetch Codex commit after ${attempt} attempts" >&2; \
            exit 1; \
        fi; \
        delay=$((attempt * 10)); \
        echo "Codex fetch attempt ${attempt} failed; retrying in ${delay}s" >&2; \
        sleep "${delay}"; \
        attempt=$((attempt + 1)); \
    done; \
    git -C /codex checkout --detach FETCH_HEAD
RUN --mount=type=cache,id=codex-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=codex-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=codex-cargo-target,target=/codex/codex-rs/target,sharing=locked \
    cargo build --release --manifest-path /codex/codex-rs/Cargo.toml -p codex-cli \
    && cp /codex/codex-rs/target/release/codex /usr/local/bin/codex

FROM openscientist-base:latest

# Install system dependencies for native extensions (scipy, h5py, scanpy, etc.) and Rust.
# The libpango/cairo/gdk-pixbuf/glib stack is required by WeasyPrint, which renders
# final_report.pdf from the report HTML. Without it WeasyPrint fails to load
# libgobject-2.0-0 and the report falls back to the fpdf2 renderer, producing a PDF
# that does not match the HTML report shown in the UI.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    libhdf5-dev \
    pkg-config \
    rustc \
    curl \
    ca-certificates \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    libffi8 \
    shared-mime-info \
    fonts-liberation \
    nftables \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --uid 1001 --create-home --shell /bin/bash agent

WORKDIR /app

# Copy project files (README.md required by pyproject.toml readme field)
COPY pyproject.toml README.md uv.lock* ./
COPY requirements/udwa-poc.txt ./requirements/udwa-poc.txt
COPY src/ ./src/

# Install the locked OpenScientist dependency graph, then the project itself
# without re-resolving it. A plain `uv pip install -e .` ignores uv.lock and can
# silently pull incompatible framework releases into the runtime image.
RUN uv export --locked --no-dev --no-emit-project --no-hashes \
        --output-file /tmp/openscientist-requirements.txt \
    && uv pip install --system -r /tmp/openscientist-requirements.txt \
    && uv pip install --system --no-deps -e . \
    && rm -f /tmp/openscientist-requirements.txt

# Install the immutable UDWA POC dependency used by the DVC
# MCP tools. The Git revision remains isolated from the main dependency set until
# compatibility is established in both runtime images. UDWA is private: the
# transient askpass helper reads the BuildKit secret without copying the token
# into an ARG, ENV, URL, filesystem layer, or build log.
RUN --mount=type=secret,id=github_token,required=true \
    set -eu; \
    askpass="$(mktemp)"; \
    trap 'rm -f "${askpass}"' EXIT; \
    printf '%s\n' \
        '#!/bin/sh' \
        'case "$1" in' \
        '  *Username*) printf "%s\n" "x-access-token" ;;' \
        '  *Password*) cat /run/secrets/github_token ;;' \
        '  *) exit 1 ;;' \
        'esac' \
        > "${askpass}"; \
    chmod 700 "${askpass}"; \
    GIT_ASKPASS="${askpass}" GIT_TERMINAL_PROMPT=0 \
        uv pip install --system -r requirements/udwa-poc.txt

# Install the open-codex CLI built in the codex-build stage above (namespace
# tools, function apply_patch, web_search capability gate, and the apply_patch
# +-prefix description fix). Built from the fork rather than the upstream
# release because the open-weight fixes are not yet upstream. It goes on PATH at
# /usr/local/bin/codex, where CodexAgent._resolve_codex_bin (shutil.which) finds
# it.
COPY --from=codex-build /usr/local/bin/codex /usr/local/bin/codex
RUN chmod +x /usr/local/bin/codex

# Copy agent entrypoint
COPY docker/agent-entrypoint.py /agent-entrypoint.py

# Air-gapped egress firewall entrypoint (used when the runner enables airgap).
COPY docker/agent-firewall-entrypoint.sh /agent-firewall-entrypoint.sh
RUN chmod +x /agent-firewall-entrypoint.sh

# Switch to non-root user
USER agent

# Job directory will be mounted at /agent/job
WORKDIR /agent/job

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["python", "/agent-entrypoint.py"]
